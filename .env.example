# Copy to .env and start with: python -m uvicorn server.main:app --env-file .env
OBJECT_MODEL_PATH=yolov8n.pt
CUSTOM_OBJECT_MODEL_PATH=models/av_obstacle.pt
TEXT_MODEL_PATH=models/text_obb.pt
OCR_LANGUAGES=en
OCR_GPU=false
DEVICE=cpu
IMAGE_SIZE=640
CONFIDENCE_THRESHOLD=0.45
TEXT_CONFIDENCE_THRESHOLD=0.40
NMS_THRESHOLD=0.5
# Milliseconds between completed requests; OCR_INTERVAL is sampled frames.
FRAME_INTERVAL=2600
OCR_INTERVAL=3
ANNOUNCEMENT_COOLDOWN=9
MAX_ANNOUNCE=3
STEP_LENGTH=0.75
CAMERA_HEIGHT=1.45
CAMERA_VFOV=50
TTS_RATE=1.05
LANGUAGE=en-IN
